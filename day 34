\\Insert an element in an array at a given position.
  #include <stdio.h>
int main()
{
int n, a[100], x, pos, i;
scanf("%d", &n);
for (i = 0; i < n; i++)
scanf("%d", &a[i]);
scanf("%d", &x);
scanf("%d", &pos);
for (i = n; i >= pos; i--)
a[i] = a[i - 1];
a[pos - 1] = x;
n++;
for (i = 0; i < n; i++)
printf("%d ", a[i]);
return 0;
}


\\Delete an element from an array.
#include <stdio.h>
int main()
{
int n, a[100], x, pos = -1, i;
scanf("%d", &n);
for (i = 0; i < n; i++)
scanf("%d", &a[i]);
scanf("%d", &x);
for (i = 0; i < n; i++)
{
if (a[i] == x)
{
pos = i;
break;
}
}
if (pos == -1)
{
printf("-1");
}
else
{
for (i = pos; i < n - 1; i++)
a[i] = a[i + 1];
n--;
for (i = 0; i < n; i++)
printf("%d ", a[i]);
}
return 0;
}
